{
  "name": "workbench",
  "version": "0.0.1",
  "private": true,
  "description": "Workbench of OpenMarksman. Baseline only so far; the code follows.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenMarksman/Workbench.git"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "biome lint .",
    "knip": "knip",
